{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sing-first-transcribe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Workers AI — runs Whisper on Cloudflare's free daily allocation.
  "ai": { "binding": "AI" },
  // Per-IP limit so one visitor can't burn the whole daily free allocation.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
