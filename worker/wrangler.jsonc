{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sing-first-transcribe",
  "account_id": "0336ad690949d1ffa8673a9922e8026c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Workers AI — runs Whisper on Cloudflare's free daily allocation.
  "ai": { "binding": "AI" },
  // Per-IP limit so one visitor can't burn the whole daily free allocation.
  // A shared table device counts as one IP, so leave room for a lively game.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
